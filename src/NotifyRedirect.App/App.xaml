<Application x:Class="NotifyRedirect.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderBrush" Value="#BFDBFE"/><Setter Property="Foreground" Value="#1E40AF"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="BorderBrush" Value="#CBD5E1"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,16,6"/></Style>
 </Application.Resources>
</Application>
